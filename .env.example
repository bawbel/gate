# bawbel-gate environment variables
# Copy to .env and adjust for your deployment.
# The gate never auto-loads this file; export these before running, or pass
# them to your process manager / container runtime.

# --- Gate runtime ---
# Path to the audit log (used by 'posture' and 'audit' commands).
# BAWBEL_AUDIT_LOG=bawbel-audit.jsonl

# Directory containing vendored JSON schemas (schemas/).
# BAWBEL_SCHEMAS_DIR=schemas

# --- Embedded console (bawbel-gate serve --console) ---
# HOST:PORT string passed to --console. Loopback only unless TLS is in front.
# BAWBEL_CONSOLE_ADDR=127.0.0.1:7317

# --- bawbel-hub ---
# Database file for the hub (SQLite). Use ':memory:' for ephemeral testing.
# BAWBEL_HUB_DB=bawbel-hub.db

# Bind address for 'bawbel-gate hub serve'.
# BAWBEL_HUB_HOST=127.0.0.1
# BAWBEL_HUB_PORT=8443

# --- OTel export (optional; requires pip install bawbel-gate[ops]) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
