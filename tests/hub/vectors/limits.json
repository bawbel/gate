    {
      "id": "limits-content-length-is-not-a-number",
      "description": "A Content-Length that is not a plain number is refused.",
      "steps": [
        {
          "raw": {
            "send": [
              "POST /v1/gates/{gate}/records HTTP/1.1",
              "Host: hub",
              "Authorization: Bearer {token}",
              "Content-Length: abc"
            ]
          },
          "expect": {
            "status": 400,
            "json": {
              "error": "bad_content_length"
            }
          }
        }
      ]
    },
    {
      "id": "limits-content-length-is-negative",
      "description": "A negative Content-Length is refused.",
      "steps": [
        {
          "raw": {
            "send": [
              "POST /v1/gates/{gate}/records HTTP/1.1",
              "Host: hub",
              "Authorization: Bearer {token}",
              "Content-Length: -1"
            ]
          },
          "expect": {
            "status": 400,
            "json": {
              "error": "bad_content_length"
            }
          }
        }
      ]
    },
    {
      "id": "limits-chunked-body-is-refused",
      "description": "A chunked body is not accepted: send a Content-Length.",
      "steps": [
        {
          "raw": {
            "send": [
              "POST /v1/gates/{gate}/records HTTP/1.1",
              "Host: hub",
              "Authorization: Bearer {token}",
              "Transfer-Encoding: chunked"
            ],
            "body": "0\r\n\r\n"
          },
          "expect": {
            "status": 411,
            "json": {
              "error": "length_required"
            }
          }
        }
      ]
    },
    {
      "id": "limits-body-ends-early",
      "description": "The client promises 100 bytes, sends 5 and closes its side.",
      "steps": [
        {
          "raw": {
            "send": [
              "POST /v1/gates/{gate}/records HTTP/1.1",
              "Host: hub",
              "Authorization: Bearer {token}",
              "Content-Length: 100"
            ],
            "body": "xxxxx",
            "half_close": true
          },
          "expect": {
            "status": 400,
            "json": {
              "error": "incomplete_body"
            }
          }
        }
      ]
    },
    {
      "id": "limits-client-that-sends-no-body-times-out",
      "description": "The client promises 100 bytes and sends none, and keeps the connection open: 408 at the deadline.",
      "steps": [
        {
          "slow": true,
          "raw": {
            "send": [
              "POST /v1/gates/{gate}/records HTTP/1.1",
              "Host: hub",
              "Authorization: Bearer {token}",
              "Content-Length: 100"
            ]
          },
          "expect": {
            "status": 408,
            "json": {
              "error": "request_timeout"
            }
          }
        }
      ]
    }
  ]
